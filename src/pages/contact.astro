---
import Layout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { socials, site } from '../data/site.js';

const email = socials.find((s) => s.label === 'Email');
const accents = ['a', 'b', 'c'];
---

<Layout title="Contact" description={`Get in touch with ${site.name}.`}>
  <PageHeader
    eyebrow="Contact"
    title="Say hello."
    lede="Email is fastest, but every one of these reaches me. I answer most things within a day or two."
    accent="b"
  />

  <section class="section">
    <div class="contact-grid">
      {socials.map((channel, i) => (
        <a
          class="card contact-card"
          data-accent={accents[i % accents.length]}
          data-reveal={i}
          href={channel.href}
          target={channel.href.startsWith('http') ? '_blank' : undefined}
          rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <div class="card-top">
            <span class="card-kicker">{channel.label}</span>
            <span class="card-go" aria-hidden="true">→</span>
          </div>
          <h3 class="contact-handle">{channel.handle}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="panel note-panel" data-reveal="0" data-accent="c">
      <p class="eyebrow">Good things to send me</p>
      <ul class="note-list">
        <li>Internship or freelance work — front-end, design systems, data visualisation.</li>
        <li>A research project that needs an interface.</li>
        <li>Something you built that you’re proud of. I like reading those.</li>
        <li>Noodle recommendations. Genuinely.</li>
      </ul>
      {email && (
        <a class="btn" href={email.href} style="margin-top: 1.75rem;">
          {email.handle} <span class="btn-arrow" aria-hidden="true">↗</span>
        </a>
      )}
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
  }

  .contact-card { min-height: 180px; justify-content: space-between; }

  /* Sized so a full email address fits on one line in the narrowest card. */
  .contact-handle {
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    overflow-wrap: break-word;
    hyphens: none;
  }

  .note-panel { max-width: 720px; }

  .note-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--ink-dim);
  }

  .note-list li { padding-left: 1.5rem; position: relative; }

  .note-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
</style>
