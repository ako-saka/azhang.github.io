---
import Layout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, skills, interests } from '../data/site.js';
import { withBase } from '../lib/url.js';
import { getImage } from 'astro:assets';
import photo8 from '../images/grid/photo-8.jpg';

// Build-time resize; the source file is a multi-megabyte camera JPEG.
const W1 = 800;
const tall = await getImage({ src: photo8, width: W1, format: 'webp', quality: 78 });
const tallH = Math.round((W1 * photo8.height) / photo8.width);

// >>> CUSTOMIZE: these three lines are the fastest way to make this page yours.
const facts = [
  { label: 'Based in', value: site.location },
  { label: 'Currently', value: 'Studying + building side projects' },
  { label: 'Looking for', value: 'Internships & collaborations' },
];
---

<Layout title="About" description={`About ${site.name} — ${site.role}.`}>
  <PageHeader eyebrow="About" title="A short introduction, honestly written." accent="b" />

  <section class="section about-lead">
    <div class="about-copy prose" data-reveal="0">
      <p style="font-size: 1.2rem; color: var(--ink);">
        Hi — I’m Aine. I’m a student at the University of Chicago studying sociology,
        statistics, and computational &amp; applied math, and I’m interested in computational
        social science research — how people interact with and construct the world around them.
      </p>
      <p>
        I’m interested in a lot of things and always looking to broaden my perspective —
        whether that’s a new dataset, a new question, or a new way of thinking about people
        and the systems they build.
      </p>
      <p>
        <strong>Outside of that:</strong> noodles, film photography, playlists that are far
        too specific, and books that make me rearrange something in my head.
      </p>
    </div>

    <div class="about-media" data-reveal="1">
      <figure class="photo photo-tall">
        <img src={tall.src} alt="Aine Zhang" width={W1} height={tallH} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="facts" data-reveal="0">
      {facts.map((fact) => (
        <div class="fact">
          <span class="fact-label">{fact.label}</span>
          <span class="fact-value">{fact.value}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head" data-reveal="0">
      <div>
        <p class="eyebrow">Toolkit</p>
        <h2>How I work</h2>
      </div>
      <p>Tools are the boring part — but here they are, grouped by the kind of thinking they’re for.</p>
    </div>

    <div class="about-skills">
      {skills.map((group, i) => (
        <div class="panel" data-accent={group.accent} data-reveal={i}>
          <h3>{group.title}</h3>
          <div class="chip-row">
            {group.items.map((item) => <span class="chip chip-accent">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="panel about-cta" data-reveal="0" data-accent="c">
      <div>
        <p class="eyebrow">Off the clock</p>
        <h2>I also spend a lot of time on things that aren’t work.</h2>
        <div class="chip-row" style="margin-top: 1.25rem;">
          {interests.slice(0, 5).map((i) => <span class="chip">{i.emoji} {i.title}</span>)}
        </div>
      </div>
      <a class="btn" href={withBase('/interests')}>
        Explore my interests <span class="btn-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .about-lead {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .about-copy { max-width: none; }

  .about-media {
    display: grid;
    gap: 1rem;
    position: sticky;
    top: 7rem;
  }

  .photo {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
    transition: transform 0.8s var(--ease), filter 0.8s var(--ease);
  }

  .photo:hover img { transform: scale(1.04); filter: saturate(1.05); }

  .photo-tall { aspect-ratio: 4 / 5; }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.6rem;
    background: var(--bg);
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .fact-value { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; }

  .about-skills {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .about-cta > div { max-width: 46ch; }

  @media (max-width: 900px) {
    .about-lead { grid-template-columns: 1fr; }
    .about-media { position: static; }
  }
</style>
