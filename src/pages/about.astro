---
import Layout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, skills, interests } from '../data/site.js';
import { withBase } from '../lib/url.js';
import { getImage } from 'astro:assets';
import photo1 from '../images/grid/photo-1.jpg';
import photo2 from '../images/grid/photo-2.jpg';

// Build-time resize; the source files are multi-megabyte camera JPEGs.
const W1 = 800;
const W2 = 800;
const tall = await getImage({ src: photo1, width: W1, format: 'webp', quality: 78 });
const wide = await getImage({ src: photo2, width: W2, format: 'webp', quality: 78 });
const tallH = Math.round((W1 * photo1.height) / photo1.width);
const wideH = Math.round((W2 * photo2.height) / photo2.width);

// >>> CUSTOMIZE: these three lines are the fastest way to make this page yours.
const facts = [
  { label: 'Based in', value: site.location },
  { label: 'Currently', value: 'Studying + building side projects' },
  { label: 'Looking for', value: 'Internships & collaborations' },
];
---

<Layout title="About" description={`About ${site.name} — ${site.role}.`}>
  <PageHeader eyebrow="About" title="A short introduction, honestly written." accent="b" />

  <section class="section about-lead">
    <div class="about-copy prose" data-reveal="0">
      <p style="font-size: 1.2rem; color: var(--ink);">
        Hi — I’m Aine. I build web experiences that blend motion, clean design and
        thoughtful interaction, and I care most about the moment where an interface
        stops feeling like a form and starts feeling like a conversation.
      </p>
      <p>
        Most of my work sits at the intersection of research and interface design. That’s
        meant building tools for questioning economic indicators, translating a
        three-thousand-year-old divination system into something you can actually use in a
        browser, and a steady stream of smaller experiments that exist purely because I
        wanted to see if they’d work.
      </p>
      <p>
        I’m drawn to projects where the visual layer is doing real work — where motion
        carries meaning rather than decoration, and where a good layout makes an argument
        legible that a paragraph couldn’t.
      </p>
      <p>
        <strong>Outside of that:</strong> noodles, film photography, playlists that are far
        too specific, and books that make me rearrange something in my head.
      </p>
    </div>

    <div class="about-media" data-reveal="1">
      <figure class="photo photo-tall">
        <img src={tall.src} alt="Aine Zhang" width={W1} height={tallH} loading="lazy" decoding="async" />
      </figure>
      <figure class="photo photo-wide">
        <img src={wide.src} alt="" width={W2} height={wideH} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="facts" data-reveal="0">
      {facts.map((fact) => (
        <div class="fact">
          <span class="fact-label">{fact.label}</span>
          <span class="fact-value">{fact.value}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head" data-reveal="0">
      <div>
        <p class="eyebrow">Toolkit</p>
        <h2>How I work</h2>
      </div>
      <p>Tools are the boring part — but here they are, grouped by the kind of thinking they’re for.</p>
    </div>

    <div class="about-skills">
      {skills.map((group, i) => (
        <div class="panel" data-accent={group.accent} data-reveal={i}>
          <h3>{group.title}</h3>
          <div class="chip-row">
            {group.items.map((item) => <span class="chip chip-accent">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="panel about-cta" data-reveal="0" data-accent="c">
      <div>
        <p class="eyebrow">Off the clock</p>
        <h2>I also spend a lot of time on things that aren’t work.</h2>
        <div class="chip-row" style="margin-top: 1.25rem;">
          {interests.slice(0, 5).map((i) => <span class="chip">{i.emoji} {i.title}</span>)}
        </div>
      </div>
      <a class="btn" href={withBase('/interests')}>
        Explore my interests <span class="btn-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .about-lead {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .about-copy { max-width: none; }

  .about-media {
    display: grid;
    gap: 1rem;
    position: sticky;
    top: 7rem;
  }

  .photo {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
    transition: transform 0.8s var(--ease), filter 0.8s var(--ease);
  }

  .photo:hover img { transform: scale(1.04); filter: saturate(1.05); }

  .photo-tall { aspect-ratio: 4 / 5; }
  .photo-wide { aspect-ratio: 3 / 2; }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.6rem;
    background: var(--bg);
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .fact-value { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; }

  .about-skills {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .chip-row { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .about-cta > div { max-width: 46ch; }

  @media (max-width: 900px) {
    .about-lead { grid-template-columns: 1fr; }
    .about-media { position: static; grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 560px) {
    .about-media { grid-template-columns: 1fr; }
  }
</style>
