---
import Layout from '../layouts/BaseLayout.astro';
import GridMotion from '../components/GridMotion.jsx';
import ProjectCard from '../components/ProjectCard.astro';
import { featured } from '../data/projects.js';
import { site } from '../data/site.js';
import { withBase } from '../lib/url.js';
import { getImage } from 'astro:assets';
import photo1 from '../images/photo-1.jpg';
import photo2 from '../images/photo-2.jpg';
import photo3 from '../images/photo-3.jpg';
import photo4 from '../images/photo-4.jpg';
import photo5 from '../images/photo-5.jpg';

// Resize + re-encode at build time. The source JPEGs are several megabytes each;
// these come out around 60–120 KB.
const tile1 = await getImage({ src: photo1, width: 640, format: 'webp', quality: 70 });
const tile2 = await getImage({ src: photo2, width: 640, format: 'webp', quality: 70 });
const tile3 = await getImage({ src: photo3, width: 640, format: 'webp', quality: 70 });
const tile4 = await getImage({ src: photo4, width: 640, format: 'webp', quality: 70 });
const tile5 = await getImage({ src: photo5, width: 640, format: 'webp', quality: 70 });
const PORTRAIT_W = 900;
const portrait = await getImage({ src: photo4, width: PORTRAIT_W, format: 'webp', quality: 78 });
const portraitH = Math.round((PORTRAIT_W * photo4.height) / photo4.width);

// 28 tiles = 4 rows × 7 columns. Mix of words, images and glyphs so the grid
// reads as a collage of what the site is about rather than filler.
const gridItems = [
  { text: 'research', kind: 'solid', tone: 'b' },
  { text: 'DeGDP', kind: 'outline' },
  { image: tile1.src, alt: '' },
  { text: '☯', kind: 'glyph' },
  { text: 'interfaces', kind: 'outline' },
  { text: 'GSAP', kind: 'mono' },
  { text: 'motion', kind: 'solid', tone: 'a' },

  { text: 'Astro', kind: 'mono' },
  { text: 'I-Ching', kind: 'outline' },
  { text: 'design', kind: 'solid', tone: 'c' },
  { image: tile2.src, alt: '' },
  { text: '🍜', kind: 'glyph' },
  { text: 'data viz', kind: 'outline' },
  { text: 'React', kind: 'mono' },

  { text: 'play', kind: 'solid', tone: 'a' },
  { text: '📷', kind: 'glyph' },
  { text: 'typography', kind: 'outline' },
  { text: 'Python', kind: 'mono' },
  { image: tile3.src, alt: '' },
  { image: tile4.src, alt: '' },
  { text: 'build', kind: 'solid', tone: 'b' },

  { text: 'curiosity', kind: 'outline' },
  { text: 'TypeScript', kind: 'mono' },
  { text: '🎧', kind: 'glyph' },
  { text: 'storytelling', kind: 'solid', tone: 'c' },
  { image: tile5.src, alt: '' },
  { text: 'prototyping', kind: 'outline' },
  { text: 'Figma', kind: 'mono' },
];
---

<Layout bleed>
  <!-- ===================== HERO ===================== -->
  <section class="hero">
    <GridMotion client:load items={gridItems} gradientColor="#123a52" />

    <div class="hero-content shell">
      <p class="eyebrow">Chicago</p>

      <h1 class="hero-title">
        <span class="hero-line">Aine</span>
        <span class="hero-line hero-name-pop">Zhang</span>
      </h1>

      <p class="hero-role">
        {site.role}
        <span class="hero-rotator" aria-hidden="true">
          <span class="hero-rotator-word" id="rotator" data-words={JSON.stringify(site.keywords)}>
            {site.keywords[0]}
          </span>
        </span>
      </p>

      <p class="lede hero-lede">{site.tagline}</p>

      <div class="hero-actions">
        <a class="btn" href={withBase('/projects')}>
          See the work <span class="btn-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="btn btn-ghost" href={withBase('/contact')}>Get in touch</a>
      </div>
    </div>

    <a class="scroll-cue" href="#intro" aria-label="Scroll to content">
      <span class="scroll-cue-line"></span>
      <span class="scroll-cue-text">scroll</span>
    </a>
  </section>

  <!-- ===================== INTRO ===================== -->
  <section class="section shell" id="intro">
    <div class="panel panel-split intro-panel" data-reveal="0">
      <div>
        <p class="eyebrow">Hello</p>
        <h2>I make software that<br />doesn’t feel like software.</h2>
        <div class="prose" style="margin-top: 1.25rem;">
          <p>
            I’m a developer and designer working somewhere between research tooling and
            interaction design. I like problems where the interface <strong>is</strong> the
            argument — where how something moves changes what it means.
          </p>
          <p>
            Recent work spans a rethinking of economic indicators, a three-thousand-year-old
            divination system rebuilt for the browser, and whatever I’m tinkering with this week.
          </p>
        </div>
        <div class="hero-actions" style="margin-top: 1.75rem;">
          <a class="btn btn-ghost" href={withBase('/about')}>
            More about me <span class="btn-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="intro-photo">
        <div class="intro-photo-frame">
          <img
            src={portrait.src}
            alt="Aine Zhang"
            width={PORTRAIT_W}
            height={portraitH}
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== WORK ===================== -->
  <section class="section shell" id="work">
    <div class="section-head" data-reveal="0">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Things I’ve made</h2>
      </div>
      <p>
        A few projects worth showing. The full list — including the half-finished ones —
        lives on the <a class="link" href={withBase('/projects')}>work page</a>.
      </p>
    </div>

    <div class="card-grid">
      {featured.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>
  </section>
</Layout>

<style>
  /* Loaded here (not the shared layout) so the extra request only happens on
     this page — used solely for the hero name below. */
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@800&display=swap');

  /* ---------------- hero ---------------- */
  /* The hero sits on GridMotion's dark tile background, not the page's white
     surface, so it scopes its own dark-mode token overrides here rather than
     using the (now light-themed) site defaults. */
  .hero {
    --ink: #f2f8f8;
    --ink-dim: #b7ccd6;
    --ink-faint: #7d97a3;
    --line: rgba(238, 246, 246, 0.16);
    --line-strong: rgba(238, 246, 246, 0.28);
    --glass: rgba(238, 246, 246, 0.06);
    --glass-hi: rgba(238, 246, 246, 0.1);
    --c: #7fd8ff;
    /* A solid base, not just the grid tiles — GridMotion's rotated container
       can leave hairline gaps at the very edges, which would otherwise show
       the page's (now white) fixed ambient background bleeding through. */
    background: #050b14;
    position: relative;
    min-height: min(100svh, 940px);
    display: grid;
    place-items: center;
    text-align: center;
    overflow: hidden;
    isolation: isolate;
    padding-block: 6rem 8rem;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: hero-in 1s var(--ease) both;
  }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }

  .hero-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 0.28em;
    margin-bottom: 0.75rem;
    font-family: 'Archivo', var(--font-display);
    font-weight: 800;
    font-size: clamp(3.5rem, 15vw, 10rem);
    line-height: 0.88;
  }

  /* Explicit color, not inherited — h1 never sets its own `color` globally,
     so without this it would inherit body's already-resolved (light-theme,
     dark) value instead of re-evaluating var(--ink) against .hero's local
     dark-mode override, making the "Aine" span invisible on the dark hero. */
  .hero-line { display: block; color: var(--ink); }

  /* Flat, not a moving gradient — a single fixed pop of the accent colour. */
  .hero-name-pop { color: var(--a); }

  .hero-role {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1.5vw, 0.92rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .hero-rotator {
    display: inline-flex;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--glass);
    color: var(--c);
    min-width: 8ch;
    justify-content: center;
  }

  .hero-rotator-word { animation: word-in 0.45s var(--ease); }

  @keyframes word-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  .hero-lede {
    margin-top: 1.5rem;
    text-align: center;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .scroll-cue {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .scroll-cue-line {
    width: 1px;
    height: 46px;
    background: linear-gradient(var(--ink-faint), transparent);
    position: relative;
    overflow: hidden;
  }

  .scroll-cue-line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 14px;
    background: var(--c);
    animation: cue 2.1s var(--ease) infinite;
  }

  @keyframes cue {
    0% { transform: translateY(-16px); opacity: 0; }
    35% { opacity: 1; }
    100% { transform: translateY(46px); opacity: 0; }
  }

  /* ---------------- intro ---------------- */
  .intro-panel { align-items: center; }

  .intro-photo { position: relative; }

  /* A soft, blurred mint/cobalt wash bleeding out from behind the frame —
     the "refreshing" backdrop, in place of the old status pill. */
  .intro-photo::before {
    content: '';
    position: absolute;
    inset: -9%;
    z-index: -1;
    background:
      radial-gradient(55% 55% at 26% 18%, rgba(0, 245, 200, 0.32), transparent 70%),
      radial-gradient(50% 50% at 82% 88%, rgba(62, 123, 250, 0.24), transparent 70%);
    filter: blur(38px);
  }

  .intro-photo-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--line);
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-md);
  }

  .intro-photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
    transition: transform 0.8s var(--ease);
  }

  .intro-photo:hover .intro-photo-frame img { transform: scale(1.04); }
</style>

<script>
  // Rotating keyword in the hero subtitle.
  const rotator = document.getElementById('rotator');
  const words = JSON.parse(rotator?.dataset.words ?? '[]');

  if (rotator && words.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    setInterval(() => {
      i = (i + 1) % words.length;
      rotator.textContent = words[i];
      // restart the entry animation
      rotator.style.animation = 'none';
      void rotator.offsetWidth;
      rotator.style.animation = '';
    }, 2200);
  }
</script>
