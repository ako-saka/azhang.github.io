---
const { eyebrow, title, lede, accent = 'a' } = Astro.props;
---

<header class="page-header" data-accent={accent}>
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {lede && <p class="lede page-header-lede">{lede}</p>}
  <slot />
</header>

<style>
  .page-header {
    padding-block: clamp(4.5rem, 12vh, 8rem) clamp(2rem, 5vh, 3.5rem);
    position: relative;
    animation: header-in 0.8s var(--ease) both;
  }

  @keyframes header-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }

  .page-header h1 {
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    max-width: 16ch;
  }

  .page-header-lede { margin-top: 1.5rem; }

  .page-header::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(100%, 620px);
    height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }
</style>
