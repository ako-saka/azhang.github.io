---
import '../styles/global.css';
import { nav, site, socials } from '../data/site.js';
import { withBase, isActive } from '../lib/url.js';
import StaggeredMenu from '../components/StaggeredMenu.jsx';

const {
  title,
  description = site.tagline,
  bleed = false, // set true when the page starts with a full-bleed hero
  dark = false, // set true for a page that should run in night mode entirely
} = Astro.props;

// `bleed` pages (the homepage) have a dark hero at the top but a normal
// white body below — so the floating menu button/theme-color stay dark-styled
// to sit on that hero, without flipping the whole page's tokens to dark mode.
const headerDark = bleed || dark;
const isDark = dark;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.role}`;
const pathname = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://ako-saka.github.io').href;
const year = new Date().getFullYear();

const navItems = nav.map((item) => {
  const href = withBase(item.href);
  return { ...item, href, current: isActive(href, pathname) };
});

const menuItems = navItems.map((item) => ({
  label: item.label,
  ariaLabel: `Go to ${item.label}`,
  link: item.href,
}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={headerDark ? '#050b14' : '#ffffff'} />

    <!-- Marks JS as available before first paint, so scroll-reveal styles only
         apply when something can actually un-hide them. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body data-theme={isDark ? 'dark' : undefined}>
    <div class="ambient"></div>
    <div class="grain"></div>

    <a class="skip-link" href="#main">Skip to content</a>

    <StaggeredMenu
      client:load
      position="right"
      items={menuItems}
      displayItemNumbering
      brandLabel={site.name}
      brandHref={withBase('/')}
      colors={['#0b2a45', '#00f5c8']}
      accentColor="#00f5c8"
      theme={headerDark ? 'dark' : 'light'}
      menuButtonColor={headerDark ? '#eef6f6' : '#0a1620'}
      openMenuButtonColor="#04101c"
    />

    <main id="main" class={bleed ? '' : 'shell'}>
      <slot />
    </main>

    <footer class="footer">
      <div class="shell">
        <div class="footer-inner">
          <div>
            <p class="eyebrow">Elsewhere</p>
            <ul class="footer-links">
              {socials.map((s) => (
                <li>
                  <a href={s.href} rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined} target={s.href.startsWith('http') ? '_blank' : undefined}>
                    <span>{s.label}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <p class="eyebrow">Pages</p>
            <ul class="footer-links">
              {navItems.map((item) => (
                <li><a href={item.href}>{item.label}</a></li>
              ))}
            </ul>
          </div>
        </div>

        <div class="footer-base">
          <span>© {year} {site.name}</span>
          <span>Built with Astro, GSAP &amp; too much coffee.</span>
        </div>
      </div>
    </footer>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0.75rem;
        z-index: 100;
        padding: 0.7rem 1.1rem;
        border-radius: 999px;
        background: #0a1620;
        color: #ffffff;
        font-weight: 600;
        text-decoration: none;
      }

      .skip-link:focus {
        left: 1rem;
      }

      /* The header is now a fixed overlay (StaggeredMenu), not an in-flow
         sticky bar, so non-bleed pages need their own top clearance. Bleed
         pages (the homepage) skip this — their hero has its own top padding
         and is meant to sit behind the transparent header. */
      main.shell {
        min-height: 55vh;
        padding-top: 4.5rem;
      }
    </style>

    <script>
      // --- scroll reveal ----------------------------------------------------
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        revealables.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
        );

        revealables.forEach((el, i) => {
          // Stagger siblings so grids cascade instead of popping in together.
          const index = Number(el.getAttribute('data-reveal')) || i % 6;
          el.style.setProperty('--reveal-delay', `${Math.min(index, 8) * 70}ms`);
          observer.observe(el);
        });
      }

      // --- cursor glow on cards --------------------------------------------
      if (!reduced && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
          card.addEventListener('pointermove', (event: PointerEvent) => {
            const rect = card.getBoundingClientRect();
            card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
            card.style.setProperty('--my', `${event.clientY - rect.top}px`);
          });
        });
      }
    </script>
  </body>
</html>
